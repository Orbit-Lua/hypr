SUPER + CTRL + L	move into group right	dsp.group.move_window{"r"}	{}
SUPER + CTRL + H	move out of group	dsp.exec_raw{"hyprctl dispatch moveoutofgroup"}	{}
SUPER + H	focus scrolling column left	fn[1/dwindle: 5/master: 5/scrolling:dsp.layout{"focus l"} 10/dwindle:]	{}
SUPER + L	focus scrolling column right	fn[1/dwindle: 5/master: 5/scrolling:dsp.layout{"focus r"} 10/dwindle:]	{}
SUPER + SHIFT + H	swap scrolling column left	fn[1/dwindle: 5/master: 5/scrolling:dsp.layout{"swapcol l"} 10/dwindle:]	{}
SUPER + SHIFT + L	swap scrolling column right	fn[1/dwindle: 5/master: 5/scrolling:dsp.layout{"swapcol r"} 10/dwindle:]	{}
SUPER + ALT + J	focus next window in scrolling column	fn[1/dwindle: 5/master: 5/scrolling:dsp.layout{"focus d"} 10/dwindle:]	{}
SUPER + ALT + K	focus previous window in scrolling column	fn[1/dwindle: 5/master: 5/scrolling:dsp.layout{"focus u"} 10/dwindle:]	{}
SUPER + O	toggle split in dwindle layout	fn[1/dwindle:dsp.layout{"togglesplit"} 5/master: 5/scrolling: 10/dwindle:dsp.layout{"togglesplit"}]	{}
SUPER + CTRL + D	remove master in master layout	fn[1/dwindle: 5/master:dsp.layout{"removemaster"} 5/scrolling: 10/dwindle:]	{}
SUPER + I	add master in master layout	fn[1/dwindle: 5/master:dsp.layout{"addmaster"} 5/scrolling: 10/dwindle:]	{}
SUPER + CTRL + Return	swap with master in master layout	fn[1/dwindle: 5/master:dsp.layout{"swapwithmaster"} 5/scrolling: 10/dwindle:]	{}
SUPER + SHIFT + I	toggle split in dwindle layout	fn[1/dwindle:dsp.layout{"togglesplit"} 5/master: 5/scrolling: 10/dwindle:dsp.layout{"togglesplit"}]	{}
SUPER + P	toggle pseudo in dwindle layout	fn[1/dwindle:dsp.window.pseudo{} 5/master: 5/scrolling: 10/dwindle:dsp.window.pseudo{}]	{}
SUPER + M	set split ratio in dwindle layout	fn[1/dwindle:dsp.exec_raw{"hyprctl dispatch splitratio 0.3"} 5/master: 5/scrolling: 10/dwindle:dsp.exec_raw{"hyprctl dispatch splitratio 0.3"}]	{}
SUPER + ALT + period	resize scrolling column wider	fn[1/dwindle: 5/master: 5/scrolling:dsp.layout{"colresize +0.1"} 10/dwindle:]	{}
SUPER + ALT + comma	resize scrolling column narrower	fn[1/dwindle: 5/master: 5/scrolling:dsp.layout{"colresize -0.1"} 10/dwindle:]	{}
SUPER + CTRL + period	promote window to scrolling column	fn[1/dwindle: 5/master: 5/scrolling:dsp.layout{"promote"} 10/dwindle:]	{}
SUPER + ALT + F	fit visible scrolling columns	fn[1/dwindle: 5/master: 5/scrolling:dsp.layout{"fit visible"} 10/dwindle:]	{}
