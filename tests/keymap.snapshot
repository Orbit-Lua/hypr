SUPER + SHIFT + up	resize up	dsp.window.resize{{relative=true,x=0,y=-50}}	{repeating=true}
SUPER + SHIFT + down	resize down	dsp.window.resize{{relative=true,x=0,y=50}}	{repeating=true}
