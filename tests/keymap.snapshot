SUPER + mouse:272	move window	dsp.window.drag{}	{mouse=true}
SUPER + mouse:273	resize window	dsp.window.resize{}	{mouse=true}
SUPER + ALT + mouse_down	zoom in	dsp.exec_raw{"hyprctl keyword cursor:zoom_factor \"$(hyprctl getoption cursor:zoom_factor | awk 'NR==1 {factor = $2; if (factor < 1) {factor = 1}; print factor * 2.0}')\""}	{}
SUPER + ALT + mouse_up	zoom out	dsp.exec_raw{"hyprctl keyword cursor:zoom_factor \"$(hyprctl getoption cursor:zoom_factor | awk 'NR==1 {factor = $2; if (factor < 1) {factor = 1}; print factor / 2.0}')\""}	{}
