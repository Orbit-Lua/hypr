      -0.5,
    },
    {
      0.68,
      1.5,
    },
  },
  type = "bezier",
})
hl.animation({
  bezier = "wind",
  enabled = true,
  leaf = "windows",
  speed = 6,
  style = "slide",
})
hl.animation({
  bezier = "winIn",
  enabled = true,
  leaf = "windowsIn",
  speed = 5,
  style = "slide",
})
hl.animation({
  bezier = "smoothOut",
  enabled = true,
  leaf = "windowsOut",
  speed = 3,
  style = "slide",
})
hl.animation({
  bezier = "wind",
  enabled = true,
  leaf = "windowsMove",
  speed = 5,
  style = "slide",
})
hl.animation({
  bezier = "liner",
  enabled = true,
  leaf = "border",
  speed = 1,
})
hl.animation({
  bezier = "liner",
  enabled = true,
  leaf = "borderangle",
  speed = 100,
  style = "loop",
})
hl.animation({
  bezier = "smoothOut",
  enabled = true,
  leaf = "fade",
  speed = 3,
})
hl.animation({
  bezier = "overshot",
  enabled = true,
  leaf = "workspaces",
  speed = 5,
})
hl.animation({
  bezier = "winIn",
  enabled = true,
  leaf = "workspacesIn",
  speed = 5,
  style = "slide",
})
hl.animation({
  bezier = "winOut",
  enabled = true,
  leaf = "workspacesOut",
  speed = 5,
  style = "slide",
})
