  fingers = 4,
})
hl.config({
  animations = {
    enabled = true,
  },
})
hl.curve("wind", {
  points = {
    {
      0.05,
      0.9,
    },
    {
      0.1,
      1.05,
    },
  },
  type = "bezier",
})
hl.curve("winIn", {
  points = {
    {
      0.1,
      1.1,
    },
    {
      0.1,
      1.1,
    },
  },
  type = "bezier",
})
hl.curve("winOut", {
  points = {
    {
      0.3,
      -0.3,
    },
    {
      0,
      1,
    },
  },
  type = "bezier",
})
