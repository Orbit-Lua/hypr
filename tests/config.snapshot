-- on hyprland.start
hl.exec_cmd("lua '<config>/lua/bin/hypr.lua' rainbow-border", {})

-- on config.reloaded
hl.exec_cmd("lua '<config>/lua/bin/hypr.lua' refresh", {})

-- on monitor.added
hl.timer(<function>, {
  timeout = 200,
  type = "oneshot",
})
hl.timer_handle.set_timeout({}, 200)
hl.timer_handle.set_enabled({}, true)

-- on monitor.removed
hl.timer_handle.set_timeout({}, 200)
hl.timer_handle.set_enabled({}, true)
